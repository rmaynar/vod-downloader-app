# Defines the Xtream account fields real_login_test.dart needs to log in
# against a real backend + real Xtream provider. The values below are
# intentionally blank - this file is committed so contributors can see what
# keys are expected. Real values are supplied by secrets.properties in this
# same directory, which is gitignored and only exists on your personal
# machine: copy this file to secrets.properties and fill in your own
# credentials there.
#
# Keys must match [a-zA-Z_][a-zA-Z0-9_]* - that's a constraint of Flutter's
# --dart-define-from-file parser, not a stylistic choice.
xtream_serverUrl=
xtream_username=
xtream_password=
xtream_label=
